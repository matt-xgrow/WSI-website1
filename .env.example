# Public site URL — drives canonical, sitemap, JSON-LD, OpenGraph.
# Leave unset on Vercel previews (auto-falls back to VERCEL_URL with noindex).
# Set on production environment to the live custom domain (no trailing slash).
NEXT_PUBLIC_SITE_URL=

# Google Analytics 4 measurement ID, for example G-XXXXXXXXXX.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Microsoft Clarity project ID.
NEXT_PUBLIC_CLARITY_PROJECT_ID=

GHL_PRIVATE_TOKEN=
GHL_LOCATION_ID=
GHL_PIPELINE_ID=
GHL_STAGE_ID=
